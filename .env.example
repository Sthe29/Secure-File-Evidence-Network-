# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# SFEN local API and PostgreSQL configuration. Never commit a real .env file.
DATABASE_URL="postgresql://sfen_user:change_this_password@localhost:5432/sfen?schema=public"
JWT_SECRET="replace-this-with-a-long-random-secret"
API_PORT="3001"
WEB_ORIGIN="http://localhost:3000"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# VITE_GOOGLE_MAPS_API_KEY: Required for Google Maps Platform and Places features.
VITE_GOOGLE_MAPS_API_KEY="MY_GOOGLE_MAPS_API_KEY"
